/* ===================== Main Window ===================== */
QMainWindow {
    background-color: #c0cfdd;
}

/* Central widget only */
QMainWindow > QWidget {
    background-color: #c0cfdd;
}

/* ===================== Group Boxes ===================== */
QGroupBox {
    font-weight: bold;
    color: #333333;   /* Group title color */
    border: 1px solid #797979;
    border-radius: 6px;
    margin-top: 8px;
    padding: 10px;
    background: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px 0 4px;
    color: #333333;
}

/* ===================== Scroll Area ===================== */
QScrollArea {
    background-color: #c0cfdd;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: #c0cfdd;
}

/* ===================== Labels ===================== */
QLabel {
    color: #333333;
    font-weight: bold;
}

/* ===================== Buttons ===================== */
QPushButton {
    background-color: #2d89ef;
    color: black;
    border-radius: 4px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #1b6fd1;
}

/* ===================== Line Edits ===================== */
QLineEdit {
    padding: 4px;
    border: 1px solid #888888;
    border-radius: 4px;
    background: white;
    color: #333333;
}

/* ===================== Tree View ===================== */
QTreeView {
    background: white;
    color: #333333;
    border: 1px solid #dcdcdc;
    border-radius: 6px;
    alternate-background-color: #f5f5f5;
    selection-background-color: #2d89ef;
    selection-color: white;
    show-decoration-selected: 1;
}

QTreeView::item {
    padding: 4px;
    color: #333333;
}

QTreeView::item:selected {
    background: #2d89ef;
    color: white;
}

QTreeView::item:hover {
    background: #e6f0ff;
}

QHeaderView::section {
    background: #f4f6f8;
    border: none;
}

/* ===================== ScrollBars ===================== */

/* Vertical ScrollBar */
QScrollBar:vertical {
    background: #c0cfdd;
    width: 12px;
    margin: 4px 0 4px 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #c1c7cd;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #a8b0b8;
}

QScrollBar::handle:vertical:pressed {
    background: #8f98a1;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;   /* remove arrows */
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* Horizontal ScrollBar */
QScrollBar:horizontal {
    background: #c0cfdd;
    height: 12px;
    margin: 0 4px 0 4px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #c1c7cd;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #a8b0b8;
}

QScrollBar::handle:horizontal:pressed {
    background: #8f98a1;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ===================== Status Bar ===================== */
QStatusBar {
    background: #e9ecef;
    color: #333333;
}
